{
  "name": "nova-api",
  "version": "2.0.0",
  "description": "NOVA API — WhatsApp Gateway con panel de control web",
  "type": "module",
  "scripts": {
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "dev": "node ./build.mjs && node --env-file=.env --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hapi/boom": "^8.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc11",
    "axios": "^1.9.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.2",
    "yt-search": "^2.10.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.14",
    "esbuild": "^0.25.0",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "^3.1.0",
    "typescript": "^5.8.0"
  },
  "engines": { "node": ">=20.0.0" }
}
